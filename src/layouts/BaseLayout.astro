---
import '@fontsource/shippori-mincho/latin-400.css';
import '@fontsource/shippori-mincho/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/noto-sans/latin-300.css';
import '@fontsource/noto-sans/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Loader from '../components/Loader.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getContent } from '../data/content';
import { languages, locales, neutralPath, pageUrl, toLang, ui } from '../i18n';
import { withBase } from '../utils/url';
import { breadcrumbSchema, websiteSchema, type BreadcrumbItem } from '../utils/schema';

interface Props {
  title: string;
  description: string;
  /** Share image path under public/ (1200×630). */
  image?: `/${string}`;
  /** Pages without a full-bleed hero get a solid header and top padding. */
  solidHeader?: boolean;
  /** Breadcrumb trail (Home is prepended automatically). */
  breadcrumbs?: BreadcrumbItem[];
  /** Extra JSON-LD nodes (e.g. Event) merged into the page's @graph. */
  extraSchema?: object[];
}

const { title, description, image = '/og-image.jpg', solidHeader = false, breadcrumbs, extraSchema = [] } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const { site } = getContent(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = neutralPath(Astro.url.pathname);
const alternates = (Object.keys(languages) as (keyof typeof languages)[]).map((code) => ({
  code,
  href: new URL(pageUrl(code, path), Astro.site).href,
}));
const imageUrl = new URL(withBase(image), Astro.site);
const home = new URL(withBase('/'), Astro.site);

// Structured data for search engines: the church, its Sunday service and its channels.
const churchId = `${home.href}#church`;
const church = {
  '@type': 'Church',
  '@id': churchId,
  name: 'Manna Tabernacle Bible Church',
  alternateName: 'MTBC',
  description: t.churchDescription,
  url: home.href,
  inLanguage: ['sw', 'en'],
  knowsLanguage: ['sw', 'en'],
  logo: new URL(withBase('/apple-touch-icon.png'), Astro.site).href,
  image: imageUrl.href,
  telephone: site.phone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kisutu Primary School Hall, Posta Mpya',
    addressLocality: 'Dar es Salaam',
    addressCountry: 'TZ',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -6.813791,
    longitude: 39.284494,
  },
  areaServed: {
    '@type': 'City',
    name: 'Dar es Salaam',
  },
  hasMap: site.mapUrl,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: 'https://schema.org/Sunday',
    opens: '10:00',
    closes: '13:00',
  },
  sameAs: [site.instagram, site.youtube],
};

// One @graph per page: the church, the website, an optional breadcrumb trail
// (Home prepended), and any page-specific nodes such as Event schema.
const graph: object[] = [
  church,
  websiteSchema({ url: home.href, name: 'Manna Tabernacle Bible Church', inLanguage: ['sw', 'en'], publisherId: churchId }),
];
if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push(breadcrumbSchema([{ name: 'Home', url: home.href }, ...breadcrumbs]));
}
for (const node of extraSchema) graph.push(node);
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

const visitHref = pageUrl(lang, '/#visit');
---

<!doctype html>
<html lang={locales[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#23211f" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manna Tabernacle Bible Church" />
    <meta property="og:locale" content={locales[lang].og} />
    {alternates.filter((alt) => alt.code !== lang).map((alt) => <meta property="og:locale:alternate" content={locales[alt.code].og} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce && !sessionStorage.getItem('mtbc-loaded')) {
            root.classList.add('is-loading');
            // Failsafe: never leave the page locked behind the loader.
            setTimeout(function () {
              root.classList.remove('is-loading', 'is-loaded');
            }, 4000);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Loader framed={!solidHeader} />
    <SiteHeader serviceTime={site.serviceTime} visitHref={visitHref} solid={solidHeader} />
    <main id="main" class:list={{ 'main--offset': solidHeader }}>
      <slot />
    </main>
    <SiteFooter />
    <MenuOverlay visitHref={visitHref} />

    <script>
      // Subtle fade-up as sections enter the viewport (skipped for reduced motion via CSS).
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      for (const item of items) observer.observe(item);
    </script>
  </body>
</html>

<style>
  .main--offset {
    padding-top: var(--header-h);
  }
</style>
