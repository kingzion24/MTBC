---
/**
 * Fixed site header (Figma 10:24 desktop, 18:38 mobile).
 * Transparent over the hero, switches to a solid night bar once the page scrolls.
 * Pages without a hero pass `solid`.
 */
import { Image } from 'astro:assets';
import logo from '../assets/mtbc-logo-white.png';
import Button from './ui/Button.astro';
import LangSwitch from './ui/LangSwitch.astro';
import { pageUrl, toLang, ui } from '../i18n';

interface Props {
  serviceTime: string;
  visitHref: string;
  solid?: boolean;
}

const { serviceTime, visitHref, solid = false } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = ui[lang];
---

<header class="header" data-header data-solid={solid ? '' : undefined} data-fixed-solid={solid ? '' : undefined}>
  <a class="header__logo" href={pageUrl(lang, '/')}>
    <Image
      src={logo}
      alt={t.homeLogoAlt}
      widths={[112, 160, 224, 320]}
      sizes="(min-width: 768px) 160px, 112px"
      loading="eager"
    />
  </a>

  <div class="header__right">
    <p class="header__service">
      <span class="header__service-label">{t.sundayService}</span>
      <span class="header__service-time">{serviceTime}</span>
    </p>
    <Button href={visitHref} variant="filled-light" compact class="header__cta">{t.planYourVisit}</Button>
    <LangSwitch />
    <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open>
      <span class="menu-toggle__lines" aria-hidden="true"></span>
      <span class="menu-toggle__label">{t.menu}</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header && !header.hasAttribute('data-fixed-solid')) {
    const update = () => header.toggleAttribute('data-solid', window.scrollY > 80);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .header {
    --focus: var(--gold-light);

    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-inline: 20px;
    color: var(--paper);
    transition: background-color 0.4s var(--ease-out);
  }

  .header[data-solid] {
    background: var(--night);
  }

  .header__logo img {
    width: 112px;
    height: auto;
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header__service,
  .header__right :global(.header__cta) {
    display: none;
  }

  .header__service {
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    line-height: normal;
    text-align: right;
    white-space: nowrap;
  }

  .header__service-label {
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .header__service-time {
    font-family: var(--serif-jp);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    /* 44px hit area without shifting the visual position */
    min-width: 44px;
    min-height: 44px;
    margin-inline: -5px;
  }

  .menu-toggle__lines {
    display: block;
    width: 28px;
    height: 7px;
    border-block: 1px solid currentColor;
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .menu-toggle:hover .menu-toggle__lines {
      transform: scaleX(1.15);
    }
  }

  .menu-toggle__label {
    font-size: 9px;
    letter-spacing: 0.24em;
    line-height: normal;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .header {
      padding-inline: 48px;
    }

    .header__logo img {
      width: 160px;
    }

    .header__right {
      gap: 28px;
    }

    .header__right :global(.header__cta) {
      display: inline-flex;
    }

    .menu-toggle__lines {
      width: 34px;
    }

    .menu-toggle__label {
      font-size: 10px;
    }
  }

  /* The service time (longer in Kiswahili) joins the header once there's room for it. */
  @media (min-width: 1024px) {
    .header__service {
      display: flex;
    }
  }
</style>
