---
/**
 * Figma: desktop 11:189, mobile 19:230 — trimmed: the four-column sitemap became one list of
 * pages plus a contact column, and the map placeholder is a real (lazy-loaded) Google Map.
 */
import { Image } from 'astro:assets';
import logo from '../assets/mtbc-logo-white.png';
import { getContent } from '../data/content';
import { pageUrl, toLang, ui } from '../i18n';

const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const { site } = getContent(lang);
const newTab = ` ${t.opensInNewTab}`;
const external = { target: '_blank', rel: 'noopener' };
const year = new Date().getFullYear();

const targets = {
  visit: '/#visit',
  events: '/events/',
  ministries: '/#ministries',
  pastor: '/#pastor',
  news: '/news/',
  contact: '/#contact',
} as const;
const pages = (Object.keys(targets) as (keyof typeof targets)[]).map((key) => ({
  label: t.nav[key].title,
  href: pageUrl(lang, targets[key]),
}));
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__main">
      <div class="footer__info">
        <a href={pageUrl(lang, '/')} class="footer__logo">
          <Image src={logo} alt={t.homeLogoAlt} widths={[180, 240, 360, 480]} sizes="(min-width: 768px) 240px, 180px" />
        </a>
        <address class="footer__address">
          <span class="footer__venue">{site.venue}</span>
          <span class="footer__street">{site.address}</span>
          <a class="footer__map-link" href={site.mapUrl} {...external}>
            {t.googleMap}<span class="visually-hidden">{newTab}</span>
          </a>
        </address>
        <div class="footer__map">
          <iframe
            src={`${site.mapEmbed}&hl=${lang}`}
            title={t.mapTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>

      <div class="footer__columns">
        <nav class="footer__group" aria-label={t.sitemap}>
          <p class="footer__group-title">
            <span>{t.footerPages.title}</span>
            <span class="footer__group-note">{t.footerPages.note}</span>
          </p>
          <ul class="footer__links">
            {
              pages.map((page) => (
                <li>
                  <a href={page.href}>{page.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="footer__group">
          <p class="footer__group-title">
            <span>{t.footerConnect.title}</span>
            <span class="footer__group-note">{t.footerConnect.note}</span>
          </p>
          <ul class="footer__links">
            <li class="footer__service">{t.sundayService} · {site.serviceTime}</li>
            <li><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>
            <li>
              <a href={site.instagram} {...external}>Instagram<span class="visually-hidden">{newTab}</span></a>
            </li>
            <li>
              <a href={site.youtube} {...external}>YouTube<span class="visually-hidden">{newTab}</span></a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__tagline">{t.tagline}</p>
      <p class="footer__copy">© {year} Manna Tabernacle Bible Church</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    --focus: var(--gold-light);

    background: var(--night);
    color: var(--paper);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 72px 40px;
  }

  .footer__main {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .footer__info {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .footer__logo {
    align-self: flex-start;
  }

  .footer__logo :global(img) {
    width: 180px;
    height: auto;
  }

  .footer__address {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    font-style: normal;
  }

  .footer__venue {
    font-family: var(--serif-jp);
    font-weight: 500;
    font-size: 15px;
    line-height: normal;
    letter-spacing: 0.1em;
  }

  .footer__street {
    color: var(--night-text);
    font-weight: 300;
    font-size: 13px;
    line-height: 2;
    letter-spacing: 0.04em;
  }

  .footer__map-link {
    color: var(--night-text);
    font-size: 11px;
    line-height: normal;
    letter-spacing: 0.14em;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-transform: uppercase;
  }

  /* Muted to sit quietly on the dark footer; full colour on hover or keyboard focus. */
  .footer__map {
    height: 200px;
    overflow: hidden;
    border: 1px solid var(--night-line);
    background: var(--night-raised);
  }

  .footer__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) contrast(1.05) brightness(0.9);
    transition: filter 0.4s var(--ease-out);
  }

  .footer__map:hover iframe,
  .footer__map:focus-within iframe {
    filter: none;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .footer__group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer__group-title {
    display: flex;
    flex-direction: column;
    font-family: var(--serif-jp);
    font-weight: 500;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0.1em;
  }

  .footer__group-note {
    color: var(--night-gold);
    font-family: var(--serif-en);
    font-style: italic;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--night-text);
    font-weight: 300;
    font-size: 13px;
    line-height: normal;
    letter-spacing: 0.04em;
  }

  .footer__links a,
  .footer__service {
    display: inline-block;
    padding-block: 3px;
  }

  @media (hover: hover) {
    .footer__links a:hover,
    .footer__map-link:hover {
      color: var(--paper);
    }
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 24px;
    border-top: 1px solid var(--night-line);
    line-height: normal;
  }

  .footer__tagline {
    color: var(--night-gold);
    font-family: var(--serif-en);
    font-style: italic;
    font-size: 16px;
    letter-spacing: 0.08em;
  }

  .footer__copy {
    color: var(--night-muted);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .footer__inner {
      gap: 96px;
      padding-block: 120px 48px;
    }

    .footer__main {
      flex-direction: row;
      gap: clamp(60px, 8.333vw, 120px);
    }

    .footer__info {
      flex: none;
      width: min(480px, 44%);
    }

    .footer__logo :global(img) {
      width: 240px;
    }

    .footer__venue {
      letter-spacing: 0.12em;
    }

    .footer__map {
      height: 240px;
    }

    .footer__columns {
      flex: 1;
      align-self: flex-start;
      gap: 40px;
    }

    .footer__group {
      gap: 20px;
    }

    .footer__group-title {
      font-size: 15px;
      letter-spacing: 0.12em;
    }

    .footer__group-note {
      font-size: 13px;
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-top: 32px;
    }

    .footer__tagline {
      font-size: 18px;
      letter-spacing: 0.1em;
    }

    .footer__copy {
      font-size: 11px;
      letter-spacing: 0.16em;
    }
  }
</style>
