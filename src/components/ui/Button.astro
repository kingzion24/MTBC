---
/**
 * Figma component "Button" (node 10:15).
 * Outline on light backgrounds, Filled for emphasis, Light variants over photography.
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'outline' | 'filled' | 'outline-light' | 'filled-light';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: Variant;
  /** Compact padding used in the desktop header. */
  compact?: boolean;
  /** Generous padding used for the stacked Contact actions. */
  large?: boolean;
  /** Stretch to the full container width below 768px (label left, arrow right). */
  blockOnMobile?: boolean;
  class?: string;
}

const {
  href,
  variant = 'outline',
  compact = false,
  large = false,
  blockOnMobile = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, { 'btn--compact': compact, 'btn--large': large, 'btn--block-mobile': blockOnMobile }, className]}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  <span class="btn__arrow" aria-hidden="true"></span>
</a>

<style>
  .btn {
    --btn-fg: var(--ink);
    --btn-bg: transparent;
    --btn-border: var(--ink);

    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 16px 24px;
    border: 1px solid var(--btn-border);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 0.1em;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  @media (min-width: 768px) {
    .btn {
      padding: 18px 32px;
    }
  }

  .btn--compact {
    padding: 14px 26px;
  }

  @media (min-width: 768px) {
    .btn--large {
      justify-content: space-between;
      padding: 26px 36px;
    }
  }

  .btn--filled {
    --btn-fg: var(--paper);
    --btn-bg: var(--ink);
  }

  .btn--outline-light {
    --btn-fg: var(--paper);
    --btn-border: var(--paper);
    --focus: var(--gold-light);
  }

  .btn--filled-light {
    --btn-bg: var(--paper);
    --btn-border: var(--paper);
    --focus: var(--gold-light);
  }

  @media (max-width: 767.98px) {
    .btn--block-mobile {
      display: flex;
      justify-content: space-between;
      width: 100%;
    }
  }

  .btn__arrow {
    width: 28px;
    height: 1px;
    background: currentColor;
    transform-origin: left center;
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .btn:hover .btn__arrow {
      transform: scaleX(1.4);
    }

    .btn--outline:hover,
    .btn--outline-light:hover {
      --btn-bg: var(--btn-border);
      --btn-fg: var(--paper);
    }

    .btn--outline-light:hover {
      --btn-fg: var(--ink);
    }
  }
</style>
