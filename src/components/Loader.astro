---
/**
 * First-visit loading screen with a percentage counter.
 * Shown only when JS runs, once per browser session, and never for reduced-motion users
 * (the `is-loading` class is set by an inline script in BaseLayout's <head>).
 * A CSS failsafe hides it after 3.5s even if the script below never runs.
 */
import { Image } from 'astro:assets';
import logo from '../assets/mtbc-logo-white.png';
---

<div class="loader" aria-hidden="true" data-loader>
  <div class="loader__inner">
    <Image src={logo} alt="" widths={[160, 320]} sizes="160px" loading="eager" class="loader__logo" />
    <p class="loader__count">Loading <span data-loader-count>0</span>%</p>
    <span class="loader__bar"><span class="loader__fill" data-loader-fill></span></span>
  </div>
</div>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('[data-loader]');

  if (loader && root.classList.contains('is-loading')) {
    const count = loader.querySelector<HTMLElement>('[data-loader-count]');
    const fill = loader.querySelector<HTMLElement>('[data-loader-fill]');
    const start = performance.now();
    const minMs = 900;
    const maxMs = 2200;
    let loaded = document.readyState === 'complete';
    window.addEventListener('load', () => (loaded = true), { once: true });

    const finish = () => {
      root.classList.add('is-loaded');
      try {
        sessionStorage.setItem('mtbc-loaded', '1');
      } catch {
        /* storage blocked: the loader just shows again next time */
      }
      loader.addEventListener('transitionend', () => root.classList.remove('is-loading', 'is-loaded'), { once: true });
    };

    const tick = (now: number) => {
      const elapsed = now - start;
      // Ease toward 90% while waiting, then run to 100% once the page has loaded.
      const ready = (loaded && elapsed >= minMs) || elapsed >= maxMs;
      const target = ready ? 1 : 0.9 * (1 - Math.exp(-elapsed / 500));
      const current = Number(fill?.dataset['p'] ?? 0);
      const next = ready ? Math.min(1, current + 0.08) : Math.max(current, target);
      if (fill) {
        fill.dataset['p'] = String(next);
        fill.style.transform = `scaleX(${next})`;
      }
      if (count) count.textContent = String(Math.round(next * 100));
      if (next >= 1) finish();
      else requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .loader {
    display: none;
  }

  :global(html.is-loading) .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--night);
    color: var(--paper);
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0.6s;
    animation: loader-failsafe 0.6s 3.5s forwards;
  }

  :global(html.is-loaded) .loader {
    opacity: 0;
    visibility: hidden;
  }

  .loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .loader__logo {
    width: 160px;
    height: auto;
  }

  .loader__count {
    color: var(--night-text);
    font-family: var(--serif-en);
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  .loader__bar {
    display: block;
    width: 160px;
    height: 1px;
    background: var(--night-line);
  }

  .loader__fill {
    display: block;
    height: 100%;
    background: var(--gold-light);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @keyframes loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
