---
/** Figma: desktop 11:102, mobile 19:96 */
import LinkList from '../ui/LinkList.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Split from '../ui/Split.astro';
import { getContent } from '../../data/content';
import { toLang, ui } from '../../i18n';

const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const { photos } = getContent(lang);
const anchors = ['#foundation', '#pastor', '#ministries'];
---

<Split id="about" labelledby="about-title" photo={photos.fellowshipGreeting}>
  <SectionHeading id="about-title" title={t.aboutTitle} label={t.aboutLabel} />
  <p class="split-lead">{t.aboutLead}</p>
  <LinkList items={t.aboutLinks.map((link, i) => ({ ...link, href: anchors[i] ?? '#about' }))} />
</Split>
