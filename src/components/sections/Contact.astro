---
/** Figma: desktop 11:172, mobile 19:215. No forms: prayer requests go by phone. */
import { Image } from 'astro:assets';
import { photos } from '../../data/content';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  visitHref: string;
  phone: { display: string; tel: string };
  officeHours: string;
}

const { visitHref, phone, officeHours } = Astro.props;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__media">
    <Image src={photos.contactPreacher.src} alt="" widths={[480, 768, 1080, 1440, 1920]} sizes="100vw" />
  </div>

  <div class="contact__inner container">
    <div class="contact__text" data-reveal>
      <SectionHeading id="contact-title" title="Come and See" label="Contact us" light />
      <p class="contact__lead">
        <span>You don't need to have anything figured out.</span>
        <span>Bring your questions, your doubts, your whole self.</span>
        <span>Our doors, and our lunch table, are always open.</span>
      </p>
    </div>

    <div class="contact__actions" data-reveal>
      <Button href={visitHref} variant="outline-light" large blockOnMobile>Plan your first visit</Button>
      <Button href={`tel:${phone.tel}`} variant="filled-light" large blockOnMobile
        >Request prayer<span class="visually-hidden"> by phone</span></Button
      >
      <p class="contact__phone">
        <a class="contact__number" href={`tel:${phone.tel}`}>{phone.display}</a>
        <span class="contact__hours">{officeHours}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    --focus: var(--gold-light);

    position: relative;
    overflow: hidden;
    background: var(--night);
    color: var(--paper);
  }

  .contact__media,
  .contact__media::after {
    position: absolute;
    inset: 0;
  }

  .contact__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact__media::after {
    content: '';
    background: rgb(24 22 20 / 0.62);
  }

  .contact__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 96px;
  }

  .contact__text {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .contact__lead {
    font-family: var(--serif-jp);
    font-size: clamp(0.875rem, 0.8286rem + 0.1905vw, 1rem); /* 14 → 16 */
    line-height: 2.2;
    letter-spacing: 0.04em;
  }

  .contact__actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact__phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding-top: 12px;
    line-height: normal;
    text-align: center;
  }

  .contact__number {
    font-family: var(--serif-en);
    font-weight: 500;
    font-size: clamp(1.875rem, 1.643rem + 0.9524vw, 2.5rem); /* 30 → 40 */
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .contact__number:hover {
      color: var(--gold-light);
    }
  }

  .contact__hours {
    opacity: 0.85;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  @media (min-width: 1024px) {
    .contact__media::after {
      background: rgb(24 22 20 / 0.55);
    }

    .contact__inner {
      flex-direction: row;
      align-items: center;
      gap: clamp(40px, 5.5vw, 80px);
      min-height: 720px;
      padding-block: 140px;
    }

    .contact__text {
      flex: 1;
      gap: 40px;
    }

    .contact__lead {
      line-height: 2.3;
    }

    .contact__lead span {
      display: block;
    }

    .contact__actions {
      flex: none;
      width: min(520px, 45%);
      gap: 20px;
    }

    .contact__actions :global(.btn) {
      justify-content: space-between;
    }

    .contact__phone {
      gap: 4px;
      padding-top: 16px;
    }

    .contact__number {
      letter-spacing: 0.1em;
    }

    .contact__hours {
      font-size: 12px;
      letter-spacing: 0.1em;
    }
  }
</style>
