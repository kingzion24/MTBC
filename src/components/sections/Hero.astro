---
/**
 * Figma: desktop 10:22, mobile 18:37. The Figma photo is replaced by short vertical clips
 * (every hero-N.mp4 that has a hero-N-poster.jpg):
 * - landscape screens: three panels side by side; as a panel's clip ends it cross-fades to a clip
 *   that isn't showing, loading or fading out in another panel, so the panels never play the
 *   same video at once;
 * - portrait screens: one panel that cycles through all of them.
 * Each panel holds two stacked videos: the next clip loads in the hidden one and fades in over
 * the last moments of the current one, so there is no blank frame between clips.
 * Posters are shown without JS, with reduced motion, or with Data Saver on.
 * Clips are encoded by scripts/encode-videos.sh into public/videos/hero/.
 *
 * The clips are pinned (sticky) for the whole wrapper: the headline and then the slotted
 * content (the Intro) scroll over them, like a film behind changing words.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import { toLang, ui } from '../../i18n';
import { withBase } from '../../utils/url';

interface Props {
  serviceTime: string;
  visitHref: string;
}

const { serviceTime, visitHref } = Astro.props;
const t = ui[toLang(Astro.currentLocale)];

const PANELS = 3;
const posters = import.meta.glob<ImageMetadata>('../../assets/photos/hero-*-poster.jpg', {
  eager: true,
  import: 'default',
});
const numberOf = (path: string) => Number(path.match(/hero-(\d+)-poster/)?.[1]);
const clips = await Promise.all(
  Object.entries(posters)
    .sort(([a], [b]) => numberOf(a) - numberOf(b))
    .map(async ([path, poster]) => ({
      src: withBase(`/videos/hero/hero-${numberOf(path)}.mp4`),
      poster: (await getImage({ src: poster, width: 720, format: 'webp', quality: 70 })).src,
    })),
);
---

<div class="hero-wrap" data-hero-wrap>
  <div class="hero__media" data-hero-media data-clips={JSON.stringify(clips)}>
    {
      clips.slice(0, PANELS).map((clip, i) => (
        <div class="hero__panel" data-hero-panel data-active={i === 0 ? '' : undefined}>
          <video
            class="hero__clip"
            src={clip.src}
            poster={clip.poster}
            muted
            playsinline
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            aria-hidden="true"
            data-front
          />
          <video
            class="hero__clip"
            muted
            playsinline
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            aria-hidden="true"
          />
        </div>
      ))
    }
  </div>

  <div class="hero-wrap__content">
  <section class="hero" aria-labelledby="hero-title">
  <div class="hero__body container">
    <h1 id="hero-title" class="hero__title">
      {t.heroTitle.map((line) => <span>{line}</span>)}
    </h1>
    <p class="hero__lead">
      <span>{t.heroLeadName}</span>
      <span>{t.heroLead[0]}<span class="hero__break"></span> {t.heroLead[1]}</span>
    </p>

    <p class="hero__service">
      <span class="hero__service-label">{t.sundayService}</span>
      <span class="hero__service-time">{serviceTime}</span>
    </p>
    <Button href={visitHref} variant="filled-light" blockOnMobile class="hero__cta">{t.planYourVisit}</Button>
  </div>

  <button
    class="hero__toggle"
    type="button"
    aria-pressed="false"
    hidden
    data-hero-toggle
    data-label-pause={t.pause}
    data-label-play={t.play}
  >
    <span data-hero-toggle-label>{t.pause}</span><span class="visually-hidden"> {t.backgroundVideo}</span>
  </button>

  </section>

  <div class="hero-wrap__after">
    <slot />
  </div>
  </div>
</div>

<script>
  interface Clip {
    src: string;
    poster: string;
  }

  /** One slot on screen: two stacked videos that take turns being in front. */
  interface Panel {
    front: HTMLVideoElement;
    back: HTMLVideoElement;
    /** Index of the clip in front. */
    clip: number;
    /** Index of the clip loading in `back`, if any. */
    next: number | null;
    /** Index of the clip still fading out underneath, if any. */
    leaving: number | null;
    /** The front clip has finished or failed: switch as soon as `back` can play. */
    waiting: boolean;
  }

  /** Cross-fade length in seconds; keep in step with the .hero__clip transition. */
  const FADE = 0.9;
  /** Start loading the next clip this many seconds before the current one ends. */
  const PRELOAD = 3;

  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const label = toggle?.querySelector('[data-hero-toggle-label]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (media && toggle && !reduceMotion.matches && !saveData) {
    const library = JSON.parse(media.dataset['clips'] ?? '[]') as Clip[];
    const panels = [...media.querySelectorAll<HTMLElement>('[data-hero-panel]')].flatMap((el, i): Panel[] => {
      const [front, back] = el.querySelectorAll('video');
      return front && back ? [{ front, back, clip: i, next: null, leaving: null, waiting: false }] : [];
    });
    /** Clips that failed to load or decode: never picked again. */
    const broken = new Set<number>();
    const triptych = window.matchMedia('(min-aspect-ratio: 6/5)');
    let paused = false;
    let visible = true;
    // Don't compete with fonts and images for the first paint: start the clips after `load`.
    let ready = document.readyState === 'complete';

    const canRun = () => !paused && visible && ready;
    // Portrait shows only the first panel; landscape shows all three.
    const visiblePanels = () => (triptych.matches ? panels : panels.slice(0, 1));

    const play = (video: HTMLVideoElement) => {
      video.play().catch(() => {
        /* Autoplay refused (e.g. Low Power Mode): the poster stays. */
      });
    };

    const unload = (video: HTMLVideoElement) => {
      video.pause();
      video.removeAttribute('src');
      video.load();
    };

    /** Clips the other visible panels are showing, loading or still fading out. */
    const reserved = (except: Panel) => {
      const taken = new Set<number>();
      for (const panel of visiblePanels()) {
        if (panel === except) continue;
        for (const clip of [panel.clip, panel.next, panel.leaving]) if (clip !== null) taken.add(clip);
      }
      return taken;
    };

    /** Next clip after the panel's own that no other visible panel has claimed. */
    const pick = (panel: Panel) => {
      const taken = reserved(panel);
      for (let step = 1; step < library.length; step++) {
        const candidate = (panel.clip + step) % library.length;
        if (!taken.has(candidate) && !broken.has(candidate)) return candidate;
      }
      return null;
    };

    /** Start loading the panel's next clip in its hidden video. */
    const prepare = (panel: Panel) => {
      // While the old clip is still fading out, `back` is busy; the swap's cleanup calls again if needed.
      if (panel.next !== null || panel.leaving !== null) return;
      const index = pick(panel);
      const clip = index === null ? undefined : library[index];
      if (index === null || !clip) return;
      panel.next = index;
      panel.back.poster = clip.poster;
      panel.back.preload = 'auto';
      panel.back.src = clip.src;
      panel.back.load();
    };

    /** Bring the loaded clip to the front and fade it in over the old one. */
    const swap = (panel: Panel) => {
      if (panel.next === null || panel.back.readyState < HTMLMediaElement.HAVE_FUTURE_DATA) return;
      const incoming = panel.back;
      const outgoing = panel.front;
      panel.front = incoming;
      panel.back = outgoing;
      panel.leaving = panel.clip;
      panel.clip = panel.next;
      panel.next = null;
      panel.waiting = false;

      // The old clip stays fully opaque underneath while the new one fades in on top.
      outgoing.dataset['leaving'] = '';
      delete outgoing.dataset['front'];
      incoming.dataset['front'] = '';
      if (canRun()) play(incoming);

      window.setTimeout(() => {
        delete outgoing.dataset['leaving'];
        unload(outgoing);
        panel.leaving = null;
        if (panel.waiting) advance(panel);
      }, FADE * 1000 + 100);
    };

    /** The front clip is over (or broken): move on now, or as soon as the next clip can play. */
    const advance = (panel: Panel) => {
      panel.waiting = true;
      prepare(panel);
      swap(panel);
      // Some phones only fetch a video once it is asked to play.
      if (panel.waiting && panel.next !== null && canRun()) play(panel.back);
    };

    /** After switching layouts, make sure no two visible panels share a clip. */
    const dedupe = () => {
      const seen = new Set<number>();
      for (const panel of visiblePanels()) {
        if (panel.next !== null && seen.has(panel.next)) {
          panel.next = null;
          unload(panel.back);
        }
        if (seen.has(panel.clip)) {
          const index = pick(panel);
          const clip = index === null ? undefined : library[index];
          if (index !== null && clip) {
            panel.clip = index;
            panel.waiting = false;
            panel.front.poster = clip.poster;
            panel.front.src = clip.src;
          }
        }
        for (const clip of [panel.clip, panel.next, panel.leaving]) if (clip !== null) seen.add(clip);
      }
    };

    const stop = () => {
      for (const panel of panels) {
        panel.front.pause();
        panel.back.pause();
      }
    };

    const start = () => {
      if (!canRun()) return;
      dedupe();
      const showing = visiblePanels();
      for (const panel of panels) {
        if (!showing.includes(panel)) {
          panel.front.pause();
          panel.back.pause();
        } else if (panel.waiting) advance(panel);
        else play(panel.front);
      }
    };

    for (const panel of panels) {
      for (const video of [panel.front, panel.back]) {
        video.addEventListener('timeupdate', () => {
          if (video !== panel.front || !Number.isFinite(video.duration)) return;
          const left = video.duration - video.currentTime;
          if (left <= PRELOAD) prepare(panel);
          if (left <= FADE) swap(panel);
        });

        video.addEventListener('ended', () => {
          // If the next clip isn't ready yet, the last frame holds until it is.
          if (video === panel.front) advance(panel);
        });

        for (const type of ['canplay', 'playing']) {
          video.addEventListener(type, () => {
            if (video === panel.back && panel.waiting) swap(panel);
          });
        }

        // If a clip can't be loaded or decoded, drop it and move on (the poster or last frame shows meanwhile).
        video.addEventListener('error', () => {
          if (!video.getAttribute('src')) return;
          if (video === panel.back && panel.leaving === null) {
            if (panel.next !== null) broken.add(panel.next);
            panel.next = null;
            unload(video);
            if (panel.waiting) advance(panel);
            else prepare(panel);
          } else if (video === panel.front) {
            broken.add(panel.clip);
            if (canRun()) advance(panel);
            else panel.waiting = true;
          }
        });
      }
    }

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      if (label) label.textContent = (paused ? toggle.dataset['labelPlay'] : toggle.dataset['labelPause']) ?? '';
      if (paused) stop();
      else start();
    });

    triptych.addEventListener('change', start);

    // Only play while the pinned clips can be seen.
    const wrap = document.querySelector('[data-hero-wrap]');
    if (wrap) {
      new IntersectionObserver(([entry]) => {
        visible = entry?.isIntersecting ?? true;
        if (visible) start();
        else stop();
      }).observe(wrap);
    }

    if (ready) start();
    else
      window.addEventListener(
        'load',
        () => {
          ready = true;
          start();
        },
        { once: true },
      );
  }
</script>

<style>
  /*
   * The film and the words share one grid cell. The film is sticky inside that cell, so it stays
   * pinned while the words scroll over it and is released exactly when the wrapper ends.
   */
  .hero-wrap {
    --focus: var(--gold-light);

    position: relative;
    display: grid;
    background: var(--night);
    color: var(--paper);
  }

  .hero__media,
  .hero-wrap__content {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .hero__media {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100lvh;
    overflow: hidden;
  }

  .hero-wrap__content {
    position: relative;
    z-index: 1;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hero {
    position: relative;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(100svh, 640px);
    padding-block: 120px 50px;
  }

  /* Darken the film as the next words arrive so they stay legible. */
  .hero-wrap__after {
    background: linear-gradient(180deg, rgb(20 18 15 / 0) 0, rgb(20 18 15 / 0.62) min(40vh, 320px));
  }

  /* Portrait: panels stacked, only the first one visible. */
  .hero__panel {
    position: absolute;
    inset: 0;
    /* Keeps the clips' z-index below the scrim. */
    isolation: isolate;
    overflow: hidden;
    opacity: 0;
  }

  .hero__panel[data-active] {
    opacity: 1;
  }

  /* Two clips per panel: the front one fades in over the one that is leaving. */
  .hero__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s linear; /* FADE in the script */
  }

  .hero__clip[data-front] {
    z-index: 1;
    opacity: 1;
  }

  .hero__clip[data-leaving] {
    opacity: 1;
    transition: none;
  }

  /* Landscape: three panels side by side. */
  @media (min-aspect-ratio: 6/5) {
    .hero__media {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__panel {
      position: relative;
      inset: auto;
      opacity: 1;
    }
  }

  /* Mobile: top-to-bottom scrim so copy at the bottom stays legible. */
  .hero__media::after {
    background: linear-gradient(
      180deg,
      rgb(18 15 13 / 0.35) 0%,
      rgb(18 15 13 / 0.1) 30%,
      rgb(18 15 13 / 0.55) 50%,
      rgb(18 15 13 / 0.85) 75%,
      rgb(18 15 13 / 0.95) 100%
    );
  }

  /* First visit: the clips start as a small window inside the loading screen, then open to full bleed. */
  :global(html.is-loading) .hero__media {
    z-index: 101;
    transform: scale(0.5);
  }

  :global(html.is-loaded) .hero__media {
    transform: none;
    transition: transform 1.4s var(--ease-out);
  }

  .hero__toggle {
    position: absolute;
    right: var(--gutter);
    bottom: 16px;
    z-index: 1;
    padding: 8px 0;
    font-size: 10px;
    line-height: normal;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .hero__toggle[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .hero__toggle:hover {
      opacity: 1;
    }
  }

  .hero__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero__title {
    font-family: var(--serif-jp);
    font-weight: 500;
    font-size: clamp(2.25rem, 1.786rem + 1.905vw, 3.5rem); /* 36 → 56 */
    line-height: 1.6;
    letter-spacing: 0.1em;
  }

  .hero__title span,
  .hero__lead > span {
    display: block;
  }

  /* Kiswahili lines run longer: keep "Hema ya chakula" on one line on phones. */
  :global(html[lang='sw']) .hero__title {
    font-size: clamp(1.75rem, 1.3rem + 2.3vw, 3.5rem);
    letter-spacing: 0.06em;
  }

  @media (min-width: 768px) {
    :global(html[lang='sw']) .hero__title {
      letter-spacing: 0.1em;
    }
  }

  .hero__lead {
    font-family: var(--serif-jp);
    font-weight: 400;
    font-size: clamp(0.8125rem, 0.743rem + 0.2857vw, 1rem); /* 13 → 16 */
    line-height: 2.1;
    letter-spacing: 0.08em;
  }

  .hero__break {
    display: block;
  }

  .hero__service {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 16px;
    width: 100%;
    padding-top: 12px;
    border-top: 1px solid rgb(255 255 255 / 0.4);
    line-height: normal;
  }

  .hero__service-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__service-time {
    font-family: var(--serif-jp);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.12em;
  }

  @media (min-width: 768px) {
    .hero {
      min-height: max(100svh, 720px);
      padding-block: 160px clamp(80px, 11vw, 159px);
    }

    /* Desktop: soft left-to-right scrim over a light overall dim. */
    .hero__media::after {
      background:
        linear-gradient(90deg, rgb(20 18 15 / 0.3), rgb(20 18 15 / 0.3)),
        linear-gradient(90deg, rgb(20 18 15 / 0.65) 0%, rgb(20 18 15 / 0.2) 60%, rgb(20 18 15 / 0.05) 100%);
    }

    .hero__body {
      gap: 32px;
    }

    .hero__title {
      line-height: 1.7;
    }

    .hero__lead {
      line-height: 2.2;
    }

    .hero__break,
    .hero__service,
    .hero__body :global(.hero__cta) {
      display: none;
    }

    .hero__toggle {
      right: auto;
      bottom: 32px;
      left: 48px;
    }
  }

  @media (min-width: 1024px) {
    .hero__title {
      letter-spacing: 0.14em;
    }

    .hero__lead {
      letter-spacing: 0.12em;
    }
  }

</style>
