---
/**
 * Figma: desktop 10:22, mobile 18:37. The Figma photo is replaced by five short vertical clips:
 * - landscape screens: three panels side by side; when a panel's clip ends it moves on to a clip
 *   that isn't showing in another panel, so the panels never play the same video at once;
 * - portrait screens: one panel that cycles through all five.
 * Posters are shown without JS, with reduced motion, or with Data Saver on.
 * Clips are encoded by scripts/encode-videos.sh into public/videos/hero/.
 *
 * The clips are pinned (sticky) for the whole wrapper: the headline and then the slotted
 * content (the Intro) scroll over them, like a film behind changing words.
 */
import { getImage } from 'astro:assets';
import poster1 from '../../assets/photos/hero-1-poster.jpg';
import poster2 from '../../assets/photos/hero-2-poster.jpg';
import poster3 from '../../assets/photos/hero-3-poster.jpg';
import poster4 from '../../assets/photos/hero-4-poster.jpg';
import poster5 from '../../assets/photos/hero-5-poster.jpg';
import Button from '../ui/Button.astro';
import { toLang, ui } from '../../i18n';
import { withBase } from '../../utils/url';

interface Props {
  serviceTime: string;
  visitHref: string;
}

const { serviceTime, visitHref } = Astro.props;
const t = ui[toLang(Astro.currentLocale)];

const PANELS = 3;
const clips = await Promise.all(
  [poster1, poster2, poster3, poster4, poster5].map(async (poster, i) => ({
    src: withBase(`/videos/hero/hero-${i + 1}.mp4`),
    poster: (await getImage({ src: poster, width: 720, format: 'webp', quality: 70 })).src,
  })),
);
---

<div class="hero-wrap" data-hero-wrap>
  <div class="hero__media" data-hero-media data-clips={JSON.stringify(clips)}>
    {
      clips.slice(0, PANELS).map((clip, i) => (
        <video
          class="hero__clip"
          src={clip.src}
          poster={clip.poster}
          data-clip={i}
          muted
          playsinline
          preload="none"
          disablepictureinpicture
          disableremoteplayback
          aria-hidden="true"
          data-active={i === 0 ? '' : undefined}
        />
      ))
    }
  </div>

  <div class="hero-wrap__content">
  <section class="hero" aria-labelledby="hero-title">
  <div class="hero__body container">
    <h1 id="hero-title" class="hero__title">
      {t.heroTitle.map((line) => <span>{line}</span>)}
    </h1>
    <p class="hero__lead">
      <span>{t.heroLeadName}</span>
      <span>{t.heroLead[0]}<span class="hero__break"></span> {t.heroLead[1]}</span>
    </p>

    <p class="hero__service">
      <span class="hero__service-label">{t.sundayService}</span>
      <span class="hero__service-time">{serviceTime}</span>
    </p>
    <Button href={visitHref} variant="filled-light" blockOnMobile class="hero__cta">{t.planYourVisit}</Button>
  </div>

  <button
    class="hero__toggle"
    type="button"
    aria-pressed="false"
    hidden
    data-hero-toggle
    data-label-pause={t.pause}
    data-label-play={t.play}
  >
    <span data-hero-toggle-label>{t.pause}</span><span class="visually-hidden"> {t.backgroundVideo}</span>
  </button>

  </section>

  <div class="hero-wrap__after">
    <slot />
  </div>
  </div>
</div>

<script>
  interface Clip {
    src: string;
    poster: string;
  }

  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const label = toggle?.querySelector('[data-hero-toggle-label]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (media && toggle && !reduceMotion.matches && !saveData) {
    const library = JSON.parse(media.dataset['clips'] ?? '[]') as Clip[];
    const panels = [...media.querySelectorAll<HTMLVideoElement>('video')];
    const triptych = window.matchMedia('(min-aspect-ratio: 6/5)');
    let paused = false;
    let visible = true;
    // Don't compete with fonts and images for the first paint: start the clips after `load`.
    let ready = document.readyState === 'complete';

    const clipOf = (panel: HTMLVideoElement) => Number(panel.dataset['clip']);
    // Portrait shows only the first panel; landscape shows all three.
    const visiblePanels = () => (triptych.matches ? panels : panels.slice(0, 1));

    const play = (video: HTMLVideoElement) => {
      video.play().catch(() => {
        /* Autoplay refused (e.g. Low Power Mode): the poster stays. */
      });
    };

    const load = (panel: HTMLVideoElement, index: number) => {
      const clip = library[index];
      if (!clip) return;
      panel.dataset['clip'] = String(index);
      panel.poster = clip.poster;
      panel.src = clip.src;
    };

    /** Next clip after `from` that no other visible panel is showing. */
    const nextFor = (panel: HTMLVideoElement) => {
      const taken = new Set(visiblePanels().filter((p) => p !== panel).map(clipOf));
      for (let step = 1; step <= library.length; step++) {
        const candidate = (clipOf(panel) + step) % library.length;
        if (!taken.has(candidate)) return candidate;
      }
      return clipOf(panel);
    };

    /** After switching layouts, make sure no two visible panels share a clip. */
    const dedupe = () => {
      const seen = new Set<number>();
      for (const panel of visiblePanels()) {
        if (seen.has(clipOf(panel))) load(panel, nextFor(panel));
        seen.add(clipOf(panel));
      }
    };

    const start = () => {
      if (paused || !visible || !ready) return;
      dedupe();
      panels.forEach((panel, i) => {
        if (visiblePanels().includes(panel)) play(panel);
        else if (i > 0) panel.pause();
      });
    };

    for (const panel of panels) {
      // If a clip can't be decoded, skip to the next one (the poster shows meanwhile).
      let failures = 0;
      panel.addEventListener('error', () => {
        if (!panel.getAttribute('src')) return;
        if (++failures >= library.length) {
          // Nothing decodes here: keep the poster and stop trying.
          panel.removeAttribute('src');
          panel.load();
          return;
        }
        load(panel, nextFor(panel));
        if (!paused && visible && ready) play(panel);
      });

      panel.addEventListener('ended', () => {
        load(panel, nextFor(panel));
        if (!paused && visible) play(panel);
      });
    }

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      if (label) label.textContent = (paused ? toggle.dataset['labelPlay'] : toggle.dataset['labelPause']) ?? '';
      if (paused) for (const panel of panels) panel.pause();
      else start();
    });

    triptych.addEventListener('change', start);

    // Only play while the pinned clips can be seen.
    const wrap = document.querySelector('[data-hero-wrap]');
    if (wrap) {
      new IntersectionObserver(([entry]) => {
        visible = entry?.isIntersecting ?? true;
        if (visible) start();
        else for (const panel of panels) panel.pause();
      }).observe(wrap);
    }

    if (ready) start();
    else
      window.addEventListener(
        'load',
        () => {
          ready = true;
          start();
        },
        { once: true },
      );
  }
</script>

<style>
  /*
   * The film and the words share one grid cell. The film is sticky inside that cell, so it stays
   * pinned while the words scroll over it and is released exactly when the wrapper ends.
   */
  .hero-wrap {
    --focus: var(--gold-light);

    position: relative;
    display: grid;
    background: var(--night);
    color: var(--paper);
  }

  .hero__media,
  .hero-wrap__content {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .hero__media {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100lvh;
    overflow: hidden;
  }

  .hero-wrap__content {
    position: relative;
    z-index: 1;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hero {
    position: relative;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(100svh, 640px);
    padding-block: 120px 50px;
  }

  /* Darken the film as the next words arrive so they stay legible. */
  .hero-wrap__after {
    background: linear-gradient(180deg, rgb(20 18 15 / 0) 0, rgb(20 18 15 / 0.62) min(40vh, 320px));
  }

  /* Portrait: clips stacked, the active one visible. */
  .hero__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .hero__clip[data-active] {
    opacity: 1;
  }

  /* Landscape: three clips side by side. */
  @media (min-aspect-ratio: 6/5) {
    .hero__media {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__clip {
      position: static;
      opacity: 1;
    }
  }

  /* Mobile: top-to-bottom scrim so copy at the bottom stays legible. */
  .hero__media::after {
    background: linear-gradient(
      180deg,
      rgb(18 15 13 / 0.35) 0%,
      rgb(18 15 13 / 0.1) 30%,
      rgb(18 15 13 / 0.55) 50%,
      rgb(18 15 13 / 0.85) 75%,
      rgb(18 15 13 / 0.95) 100%
    );
  }

  /* First visit: the clips start as a small window inside the loading screen, then open to full bleed. */
  :global(html.is-loading) .hero__media {
    z-index: 101;
    transform: scale(0.5);
  }

  :global(html.is-loaded) .hero__media {
    transform: none;
    transition: transform 1.4s var(--ease-out);
  }

  .hero__toggle {
    position: absolute;
    right: var(--gutter);
    bottom: 16px;
    z-index: 1;
    padding: 8px 0;
    font-size: 10px;
    line-height: normal;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .hero__toggle[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .hero__toggle:hover {
      opacity: 1;
    }
  }

  .hero__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero__title {
    font-family: var(--serif-jp);
    font-weight: 500;
    font-size: clamp(2.25rem, 1.786rem + 1.905vw, 3.5rem); /* 36 → 56 */
    line-height: 1.6;
    letter-spacing: 0.1em;
  }

  .hero__title span,
  .hero__lead > span {
    display: block;
  }

  /* Kiswahili lines run longer: keep "Mkate wa kila siku" on one line on phones. */
  :global(html[lang='sw']) .hero__title {
    font-size: clamp(1.75rem, 1.3rem + 2.3vw, 3.5rem);
    letter-spacing: 0.06em;
  }

  @media (min-width: 768px) {
    :global(html[lang='sw']) .hero__title {
      letter-spacing: 0.1em;
    }
  }

  .hero__lead {
    font-family: var(--serif-jp);
    font-weight: 400;
    font-size: clamp(0.8125rem, 0.743rem + 0.2857vw, 1rem); /* 13 → 16 */
    line-height: 2.1;
    letter-spacing: 0.08em;
  }

  .hero__break {
    display: block;
  }

  .hero__service {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 16px;
    width: 100%;
    padding-top: 12px;
    border-top: 1px solid rgb(255 255 255 / 0.4);
    line-height: normal;
  }

  .hero__service-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__service-time {
    font-family: var(--serif-jp);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.12em;
  }

  @media (min-width: 768px) {
    .hero {
      min-height: max(100svh, 720px);
      padding-block: 160px clamp(80px, 11vw, 159px);
    }

    /* Desktop: soft left-to-right scrim over a light overall dim. */
    .hero__media::after {
      background:
        linear-gradient(90deg, rgb(20 18 15 / 0.3), rgb(20 18 15 / 0.3)),
        linear-gradient(90deg, rgb(20 18 15 / 0.65) 0%, rgb(20 18 15 / 0.2) 60%, rgb(20 18 15 / 0.05) 100%);
    }

    .hero__body {
      gap: 32px;
    }

    .hero__title {
      line-height: 1.7;
    }

    .hero__lead {
      line-height: 2.2;
    }

    .hero__break,
    .hero__service,
    .hero__body :global(.hero__cta) {
      display: none;
    }

    .hero__toggle {
      right: auto;
      bottom: 32px;
      left: 48px;
    }
  }

  @media (min-width: 1024px) {
    .hero__title {
      letter-spacing: 0.14em;
    }

    .hero__lead {
      letter-spacing: 0.12em;
    }
  }

</style>
