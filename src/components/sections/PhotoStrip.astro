---
/**
 * Figma: desktop 11:48, mobile 18:139.
 * On pointer devices without reduced motion the row drifts slowly as a seamless loop
 * (with a pause control). Touch devices and reduced-motion users get a swipeable row.
 */
import { Image } from 'astro:assets';
import type { Photo } from '../../data/content';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<section class="strip" aria-label="Photos from church life" data-strip>
  <div class="strip__viewport">
    <ul class="strip__track" role="list">
      {
        photos.map((photo) => (
          <li class="strip__item">
            <Image src={photo.src} alt={photo.alt} widths={[220, 300, 440, 600]} sizes="(min-width: 768px) 300px, 220px" />
          </li>
        ))
      }
      {
        /* Duplicate set for the seamless loop; hidden from assistive tech. */
        photos.map((photo) => (
          <li class="strip__item strip__item--clone" aria-hidden="true">
            <Image src={photo.src} alt="" widths={[220, 300, 440, 600]} sizes="(min-width: 768px) 300px, 220px" />
          </li>
        ))
      }
    </ul>
  </div>
  <button class="strip__toggle" type="button" aria-pressed="false" data-strip-toggle>Pause</button>
</section>

<script>
  for (const strip of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    const toggle = strip.querySelector<HTMLButtonElement>('[data-strip-toggle]');
    toggle?.addEventListener('click', () => {
      const paused = strip.toggleAttribute('data-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? 'Play' : 'Pause';
    });
  }
</script>

<style>
  .strip {
    --item-w: 220px;
    --item-h: 160px;
    --gap: 10px;

    position: relative;
    padding-block: 10px;
  }

  .strip__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .strip__viewport::-webkit-scrollbar {
    display: none;
  }

  .strip__track {
    display: flex;
    gap: var(--gap);
    width: max-content;
  }

  .strip__item {
    flex: none;
    width: var(--item-w);
    height: var(--item-h);
    scroll-snap-align: start;
  }

  .strip__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .strip__item--clone,
  .strip__toggle {
    display: none;
  }

  @media (min-width: 768px) {
    .strip {
      --item-w: 300px;
      --item-h: 220px;
      --gap: 16px;

      padding-block: 16px;
    }
  }

  /* Drifting loop for mouse/trackpad users who haven't asked for reduced motion. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .strip__viewport {
      overflow: hidden;
    }

    .strip__item--clone {
      display: block;
    }

    .strip__track {
      animation: strip-drift 60s linear infinite;
    }

    .strip:hover .strip__track,
    .strip:focus-within .strip__track,
    .strip[data-paused] .strip__track {
      animation-play-state: paused;
    }

    .strip__toggle {
      position: absolute;
      right: var(--gutter);
      bottom: calc(var(--gap) + 12px);
      display: block;
      padding: 6px 12px;
      background: rgb(35 33 31 / 0.6);
      color: var(--paper);
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      --focus: var(--gold-light);
    }
  }

  @keyframes strip-drift {
    to {
      /* One full set: n items plus n gaps. */
      transform: translateX(-50%) translateX(calc(var(--gap) / -2));
    }
  }
</style>
