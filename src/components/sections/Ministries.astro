---
/**
 * Figma: desktop 11:54, mobile 19:51.
 * The Figma tabs (Small Groups / Serve Teams / Care & Prayer) are dropped: the church has five
 * ministries with no sub-groups, so they're shown as cards. Cards swipe sideways on mobile.
 */
import { Image } from 'astro:assets';
import type { Ministry } from '../../data/content';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { toLang, ui } from '../../i18n';
import Tag from '../ui/Tag.astro';

interface Props {
  ministries: Ministry[];
  findHref: string;
}

const { ministries, findHref } = Astro.props;
const t = ui[toLang(Astro.currentLocale)];
---

<section id="ministries" class="ministries" aria-labelledby="ministries-title">
  <div class="container" data-reveal>
    <SectionHeading id="ministries-title" title={t.ministriesTitle} label={t.ministriesLabel} />
  </div>

  <div class="ministries__body container">
    <div class="ministries__intro">
      <p class="ministries__lead" data-reveal>
        {t.ministriesLead}
      </p>
      <Button href={findHref} blockOnMobile>{t.findYourPlace}</Button>
    </div>

    <ul class="ministries__cards" role="list">
      {
        ministries.map((item) => (
          <li class="ministry" data-reveal>
            <Image
              src={item.photo.src}
              alt={item.photo.alt}
              widths={[212, 260, 424, 520]}
              sizes="(min-width: 1024px) 212px, 260px"
              class="ministry__img"
            />
            {item.tags && item.tags.length > 0 && (
              <ul class="ministry__tags" aria-label={t.whereAndWhen}>
                {item.tags.map((tag) => (
                  <li>
                    <Tag>{tag}</Tag>
                  </li>
                ))}
              </ul>
            )}
            <h3 class="ministry__title">{item.title}</h3>
            <p class="ministry__desc">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ministries {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 96px;
  }

  .ministries__body {
    display: grid;
    grid-template-areas: 'lead' 'cards' 'cta';
    gap: 32px;
  }

  /* Mobile: lead, then cards, then the button. */
  .ministries__intro {
    display: contents;
  }

  .ministries__lead {
    grid-area: lead;
    font-family: var(--serif-jp);
    font-size: clamp(0.875rem, 0.8286rem + 0.1905vw, 1rem); /* 14 → 16 */
    line-height: 2.2;
    letter-spacing: 0.04em;
  }

  .ministries__intro :global(.btn) {
    grid-area: cta;
  }

  .ministries__cards {
    grid-area: cards;
    display: flex;
    gap: 16px;
    min-width: 0;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .ministries__cards::-webkit-scrollbar {
    display: none;
  }

  .ministry {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 10px;
    width: 260px;
    scroll-snap-align: start;
  }

  .ministry__img {
    width: 100%;
    aspect-ratio: 260 / 190;
    object-fit: cover;
  }

  .ministry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ministry__title {
    padding-top: 6px;
    font-family: var(--serif-jp);
    font-weight: 500;
    font-size: 16px;
    line-height: normal;
    letter-spacing: 0.06em;
  }

  .ministry__desc {
    color: var(--soft);
    font-weight: 300;
    font-size: 12px;
    line-height: 1.8;
    letter-spacing: 0.04em;
  }

  @media (min-width: 1024px) {
    .ministries {
      gap: 56px;
      padding-block: 180px;
    }

    .ministries__body {
      grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
      grid-template-areas: 'intro cards';
      column-gap: clamp(40px, 5.5vw, 80px);
    }

    .ministries__intro {
      grid-area: intro;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 48px;
    }

    .ministries__lead {
      line-height: 2.3;
    }

    .ministries__cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px 32px;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .ministry {
      gap: 12px;
      width: auto;
    }

    .ministry__img {
      aspect-ratio: 212 / 220;
    }

    .ministry__title {
      padding-top: 8px;
      font-size: 18px;
      line-height: 1.7;
      letter-spacing: 0.08em;
    }

    .ministry__desc {
      font-size: 13px;
      line-height: 1.9;
    }
  }
</style>
