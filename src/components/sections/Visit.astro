---
/** Figma: desktop 11:126, mobile 19:171 */
import { getContent } from '../../data/content';
import { toLang, ui } from '../../i18n';
import LinkList from '../ui/LinkList.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Split from '../ui/Split.astro';

interface Props {
  venue: string;
  serviceShort: string;
  mapUrl: string;
}

const { venue, serviceShort, mapUrl } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const { photos } = getContent(lang);
---

<Split id="visit" labelledby="visit-title" photo={photos.sundayServiceHall} photoEnd>
  <SectionHeading id="visit-title" title={t.visitTitle} label={venue} />
  <p class="split-lead">{t.visitLead}</p>
  <LinkList
    items={[
      { title: venue, note: t.googleMap, href: mapUrl, external: true },
      { title: t.serviceTimes, note: serviceShort, href: '#contact' },
    ]}
  />
</Split>
