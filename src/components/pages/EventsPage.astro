---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../EventCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getContent } from '../../data/content';
import { pageUrl, toLang, ui } from '../../i18n';
import { withBase } from '../../utils/url';
import { eventSchema } from '../../utils/schema';

const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const { events } = getContent(lang);

// Event JSON-LD for the current events, so services can surface as rich results.
const churchId = `${new URL(withBase('/'), Astro.site).href}#church`;
const eventsUrl = new URL(pageUrl(lang, '/events/'), Astro.site).href;
const eventNodes = events
  .map((event) =>
    eventSchema(
      { title: event.title, subtitle: event.subtitle, place: event.place, online: event.online, schedule: event.schedule },
      {
        image: new URL(event.photo.src.src, Astro.site).href,
        organizerId: churchId,
        timeZone: 'Africa/Dar_es_Salaam',
        addressLocality: 'Dar es Salaam',
        addressCountry: 'TZ',
      },
    ),
  )
  .filter((node): node is object => node !== null);
const breadcrumbs = [{ name: t.eventsTitle, url: eventsUrl }];
---

<BaseLayout
  title={t.eventsPageTitle}
  description={t.eventsPageDescription}
  solidHeader
  breadcrumbs={breadcrumbs}
  extraSchema={eventNodes}
>
  <div class="page container">
    <SectionHeading id="page-title" title={t.eventsTitle} label={t.eventsLabel} layout="stacked" level="h1" />
    <p class="page__lead">{t.eventsLead}</p>
    {
      events.length > 0 ? (
        <ul class="page__grid" role="list">
          {events.map((event) => (
            <li>
              <EventCard event={event} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="page__lead">{t.noEvents}</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 64px 96px;
  }

  .page__lead {
    max-width: 32em;
    font-family: var(--serif-jp);
    font-size: clamp(0.875rem, 0.8286rem + 0.1905vw, 1rem);
    line-height: 2.2;
    letter-spacing: 0.04em;
  }

  .page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 32px;
  }

  .page__grid > li {
    display: flex;
    background: var(--sand);
  }

  .page__grid > li > :global(*) {
    flex: 1;
    border: 1px solid var(--line);
  }

  @media (min-width: 1024px) {
    .page {
      gap: 48px;
      padding-block: 120px 160px;
    }
  }
</style>
