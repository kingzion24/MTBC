---
/** One teaching series: every part in order, playable on the page. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import SermonList from '../SermonList.astro';
import VideoDialog from '../VideoDialog.astro';
import { getContent } from '../../data/content';
import { locales, pageUrl, toLang, ui } from '../../i18n';
import type { Series } from '../../utils/sermons';

interface Props {
  series: Series;
}

const { series } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const { pastor } = getContent(lang);

const monthYear = new Intl.DateTimeFormat(locales[lang].intl, {
  month: 'long',
  year: 'numeric',
  timeZone: 'Africa/Dar_es_Salaam',
});
const from = monthYear.format(new Date(series.from));
const to = monthYear.format(new Date(series.to));
const label = `${series.sermons.length} ${t.parts} · ${from === to ? from : `${from} – ${to}`}`;

const pastorUrl = pageUrl(lang, '/pastor/');
const breadcrumbs = [
  { name: pastor.name, url: new URL(pastorUrl, Astro.site).href },
  { name: series.title, url: new URL(pageUrl(lang, `/pastor/${series.slug}/`), Astro.site).href },
];
---

<BaseLayout
  title={`${series.title} — ${pastor.name} — MTBC`}
  description={`${series.title}: ${label}. ${t.seriesPageLead}`}
  solidHeader
  breadcrumbs={breadcrumbs}
>
  <div class="page container">
    <a class="page__back" href={`${pastorUrl}#series`}>
      <span class="page__back-line" aria-hidden="true"></span>
      {t.allSeries}
    </a>
    <SectionHeading id="page-title" title={series.title} label={label} layout="stacked" level="h1" />
    <p class="page__lead">{pastor.name}. {t.seriesPageLead}</p>
    <SermonList sermons={series.sermons} ordered />
  </div>

  <VideoDialog />
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 64px 96px;
  }

  .page :global(.heading__title) {
    overflow-wrap: anywhere;
  }

  .page__back {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 10px;
    font-size: 12px;
    line-height: normal;
    letter-spacing: 0.1em;
  }

  .page__back-line {
    width: 18px;
    height: 1px;
    background: var(--ink);
    transform-origin: right center;
    transition: transform 0.4s var(--ease-out);
  }

  .page__lead {
    max-width: 36em;
    font-family: var(--serif-jp);
    font-size: clamp(0.875rem, 0.8286rem + 0.1905vw, 1rem);
    line-height: 2.2;
    letter-spacing: 0.04em;
  }

  @media (hover: hover) {
    .page__back:hover .page__back-line {
      transform: scaleX(1.5);
    }
  }

  @media (min-width: 1024px) {
    .page {
      gap: 48px;
      padding-block: 120px 160px;
    }
  }
</style>
