---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { stories } from '../data/content';
---

<BaseLayout
  title="Life Together — Stories from MTBC Dar es Salaam"
  description="Worship, prayer and friendship, woven into ordinary days. A glimpse of life at Manna Tabernacle Bible Church."
  solidHeader
>
  <div class="page container">
    <SectionHeading id="page-title" title="Life Together" label="Stories" layout="stacked" level="h1" />
    <p class="page__lead">Worship, prayer and friendship, woven into ordinary days. A glimpse of life at MTBC.</p>
    <ul class="page__grid" role="list">
      {
        stories.map((story) => (
          <li>
            <figure class="story">
              <Image
                src={story.photo.src}
                alt={story.photo.alt}
                widths={[360, 540, 720, 1080]}
                sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 100vw"
                class="story__img"
              />
              <figcaption class="story__text">
                {story.quote && <span class="story__quote">{story.quote.replace('\n', ' ')}</span>}
                {story.caption && <span class="story__caption">{story.caption}</span>}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 64px 96px;
  }

  .page__lead {
    max-width: 32em;
    font-family: var(--serif-jp);
    font-size: clamp(0.875rem, 0.8286rem + 0.1905vw, 1rem);
    line-height: 2.2;
    letter-spacing: 0.04em;
  }

  .page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 48px 32px;
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .story__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .story__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .story__quote {
    font-family: var(--serif-en);
    font-style: italic;
    font-size: 24px;
    line-height: 1.4;
  }

  .story__caption {
    color: var(--soft);
    font-family: var(--serif-jp);
    font-size: 14px;
    line-height: 2;
    letter-spacing: 0.04em;
  }

  @media (min-width: 1024px) {
    .page {
      gap: 48px;
      padding-block: 120px 160px;
    }
  }
</style>
