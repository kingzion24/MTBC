{
  "compilerOptions": {
    "target": "ES2022", "module": "Preserve", "moduleResolution": "Bundler", "jsx": "preserve",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
